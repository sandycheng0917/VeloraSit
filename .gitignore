# ══════════════════════════════════════════════════════════
#  這個 repo 要轉成 private，但 private 不等於可以放機密。
#  下面每一條規則的理由都跟可見性無關：
#
#    · CI 會把整個 repo clone 進第三方建置容器
#      （GitHub Actions runner、Cloudflare Workers Builds），
#      機密會跟著進去，而建置日誌不一定遮罩得住
#    · git 歷史是永久的。放進去一次，之後刪掉也還在歷史裡
#    · 可見性是一個開關，而開關會被按錯
#
#  2026-09-22 之前這裡寫的是「這個 repo 會公開」。前提變了，
#  但規則一條都沒有放寬 —— 只有理由改寫。
# ══════════════════════════════════════════════════════════

# ── 相依套件與建置產物 ──────────────────────────────────
node_modules/
dist/
.vite/

# ── 保險：機密文件格式一律不進版控（不限位置）──────────────
# 就算日後有人把 Excel 或型錄 PDF 放到別的資料夾，這幾條也會擋住。
# 真的需要版控某個 pdf/xlsx 時，用 git add -f 明確覆寫，不要改這裡。
*.xlsx
*.xlsm
*.xls
*.pdf
*.csv
*.docx

# ── 供應商原始素材：一律不進版控 ────────────────────────
# 這個資料夾含不該公開的東西：
#   · 絲巾與飾品.xlsx        FOB 出口單價、供應商業務姓名與手機、事業登記號
#   · VUCA 型錄 PDF          製造商 Welkeeps 的地址、電話與信箱
#   · 原始模特兒照與商品照    供應商素材，處理後的版本才放進 public/media/
# 需要重跑素材管線的人，請透過加密管道另外取得這個資料夾。
#
# 🔴 轉 private 也不放寬。這些是**第三方的個資與商業機密**，不是你的 ——
#    你沒有權限決定它們的曝光程度。而且一旦外洩，這一類資料無法「輪替」。
design/sample/

# ── 設計交付物：不進版控 ────────────────────────────────
# 原本的理由是「超出公開 16 張圖的範圍」。轉 private 之後那個理由消失了，
# 但規則保留，改用一個跟可見性無關的理由：**可重生的大型二進位不該進版控**。
#   · exports/            28 個 PNG，node design/shoot.mjs 可重生
#   · velora_design.ep    內嵌 28 張影像，python design/build-ep.py 可重生
design/exports/
design/velora_design.ep

# ── 機密監看清單 ────────────────────────────────────────
# check-public.mjs 用來比對的確切機密字串（16 筆：供應商姓名、手機、
# 事業登記號、FOB 實際數字）。
#
# 🔴 轉 private 也不放寬。這個檔案是「機密清單本身」——
#    提交它等於把所有機密集中成一份攻擊者的購物清單，
#    而它存在的目的正好相反：讓 check-public.mjs 驗「這些字有沒有漏進版控」。
#    把監看清單提交上去，等於把警報器的鑰匙掛在門上。
.secret-watch.txt

# ── 後台：現在進版控了 ──────────────────────────────────
#
# 2026-09-06 改變。原本整個後台排除在版控外，理由是「原始碼留在公開 repo
# 等於把內部工具的版面攤開」。但後台改成從 Google Sheet 讀資料之後，
# CI 必須建得出它 —— 建不出來就沒有 /admin/ 可用。
#
# 現在的做法是「兩份 bundle 分開產生」而不是「原始碼不存在」：
#   npm run build        公開版，router 的 IS_PUBLIC 分支讓 Rollup 整段移除後台
#   npm run build:admin  後台版，輸出到 /admin/
# deploy.yml 有兩道對稱的關卡驗這件事：後台不得出現在 v1/v2，
# 且必須出現在 admin —— 只有前者的話，一個空的 admin 目錄會無條件通過。
#
# 後台原始碼在 velora-frontend/src/admin/，裡面沒有機密：
# 端點網址由 VITE_EXEC_URL 於建置時代入，密碼與金鑰都在 Apps Script 的
# 指令碼屬性裡。已實測現行機密正則對這幾個檔案零命中。
#
# 寫後台程式碼時有兩個偽陽性陷阱：
#   · 不要寫 10 位數字面值（用 8 * 3600 * 1000，不要寫展開值）
#   · 成本欄的標籤寫「成本（FOB）」，不要寫韓文的「단가」
#
# 下面這三個是舊的原型，已經沒有任何地方 import 它們（router 指向
# src/admin/AdminView.vue）。留在本機不影響建置，但也可以直接刪掉。
velora-frontend/src/views/AdminView.vue
velora-frontend/src/components/ProductDrawer.vue
velora-frontend/src/components/ToggleSwitch.vue
design/spec/02-admin-dashboard.md
#
# 這兩個檔案光看檔名看不出來，但內容含完整的後台版面：
#   · style-preview.html —— Board 03/04 是後台與抽屜的 HTML 實作
#   · build-ep.py        —— page_admin() 與 page_states() 是後台的逐元件座標
# 它們產生的 .ep 本來就只留本機，生成器一併移出才一致。
design/mockup/
design/build-ep.py
design/ep_shapes.py

# ── Apps Script 本機開發 ────────────────────────────────
# 程式碼本身要進版控（沒有機密：密碼雜湊、HMAC 密鑰、GitHub PAT
# 全部存在 Apps Script 的 Script Properties，不在原始碼裡）。
# 但 clasp 的設定檔含 script ID 與 OAuth token，不進版控。
apps-script/.clasp.json
apps-script/.clasprc.json

# ── Cloudflare 本機狀態 ─────────────────────────────────
# 🔴 .wrangler/state/v3/d1/ 是本機 D1 的 SQLite 檔。只要用 --local 跑過一次
#    遷移或測試，裡面就有完整的 FOB 成本與供應商手機。
#
#    而且它是**二進位檔** —— git grep -I 預設跳過二進位，
#    check-public.mjs 的機密掃描看不進去。也就是說這條規則失效時，
#    現有的稽核工具不會告訴你。這是整份清單裡唯一「沒有第二道網」的一條。
#
# .dev.vars 是 wrangler dev 的本機 secrets（等同 .env）。
.wrangler/
.dev.vars
.dev.vars.*

# ── 遷移腳本的輸出與資料庫備份 ──────────────────────────
# migrate-out/02-private.sql 是含 FOB 單價與供應商聯絡資訊的**明文 SQL**。
# wrangler d1 export 的輸出同理（含 products_private 與 suppliers）。
#
# 這幾條刻意排在寫遷移腳本「之前」就加進來 ——
# 先產生檔案再補規則的話，中間那段時間一次 git add -A 就結束了。
tools/migrate-out/
*.private.sql
backup/

# ── 保險：憑證檔一律不進版控（不限位置）──────────────────
# 這幾條在有人「先放著等一下再刪」的時候擋住第一次 commit。
*.pem
*.key
*.p12
service-account*.json
credentials.json
**/token.json
.env.local
.env.*.local

# ── 建置組裝目錄 ────────────────────────────────────────
# CI 把三個站組裝到這裡再上傳，可重生，不進版控。
build/

# ── 個人化設定 ──────────────────────────────────────────
# CLAUDE.md 與 .claude/skills/ 是專案文件，要留著
.claude/settings.local.json

# ── 系統雜項 ────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log
