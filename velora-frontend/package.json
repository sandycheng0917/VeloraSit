{
  "name": "velora-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode public",
    "dev:admin": "vite",
    "build": "vite build --mode public",
    "build:admin": "vite build",
    "preview": "vite preview",
    "build:worker": "vite build --mode public && vite build --outDir dist/admin --base /admin/ && node -e \"require('fs').rmSync('dist/admin/media',{recursive:true,force:true})\" && npm run audit",
    "audit": "node ../tools/check-gates.mjs && node ../check-public.mjs --dist velora-frontend/dist",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply veloradb_sit --remote",
    "d1:seed": "node ../tools/d1-seed.mjs && wrangler d1 execute veloradb_sit --remote --file ../build/d1-seed.sql"
  },
  "dependencies": {
    "@lucide/vue": "^1.37.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wrangler": "^3.114.0"
  }
}
